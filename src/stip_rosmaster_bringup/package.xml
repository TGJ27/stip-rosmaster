<?xml version="1.0"?>
<package format="2">
  <name>stip_rosmaster_bringup</name>
  <version>0.1.0</version>
  <description>Minimal STIP ROSMaster X3 Plus base, odometry, IMU, EKF and arm interface.</description>
  <maintainer email="noreply@example.com">STIP</maintainer>
  <license>Proprietary</license>
  <buildtool_depend>catkin</buildtool_depend>
  <depend>roscpp</depend>
  <depend>rospy</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
