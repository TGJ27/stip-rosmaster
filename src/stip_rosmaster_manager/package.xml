<?xml version="1.0"?>
<package format="2">
  <name>stip_rosmaster_manager</name>
  <version>1.5.0</version>
  <description>STIP ROSMASTER staged application startup, health gating, module recovery and graceful shutdown.</description>
  <maintainer email="jetson@example.com">STIP</maintainer>
  <license>MIT AND GPL-2.0-or-later</license>
  <buildtool_depend>catkin</buildtool_depend>
  <depend>rospy</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <exec_depend>rosnode</exec_depend>
  <exec_depend>rosservice</exec_depend>
  <exec_depend>python3-rospkg</exec_depend>
  <exec_depend>stip_rosmaster_bringup</exec_depend>
  <exec_depend>stip_inspection_camera</exec_depend>
  <exec_depend>stip_qr_inspection</exec_depend>
  <exec_depend>stip_fire_detection</exec_depend>
  <exec_depend>stip_gas_sensor</exec_depend>
  <exec_depend>stip_thermal_camera</exec_depend>
  <export/>
  <depend>dynamic_reconfigure</depend>
  <depend>tf</depend>
  <depend>nav_msgs</depend>
  <exec_depend>rqt_reconfigure</exec_depend>
  <exec_depend>imu_calib</exec_depend>
</package>
