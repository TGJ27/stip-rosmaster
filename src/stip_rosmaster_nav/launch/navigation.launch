<launch>
  <!-- Navigation only. Assumes base odometry/TF and /scan already exist. -->
  <arg name="use_rviz" default="true"/>
  <arg name="map" default="my_map"/>

  <node name="map_server" pkg="map_server" type="map_server"
        args="$(find stip_rosmaster_nav)/maps/$(arg map).yaml"/>

  <include file="$(find stip_rosmaster_nav)/launch/library/amcl.launch"/>
  <include file="$(find stip_rosmaster_nav)/launch/library/move_base.launch"/>

  <group if="$(arg use_rviz)">
    <include file="$(find stip_rosmaster_nav)/launch/view/view_navigate.launch"/>
  </group>
</launch>
